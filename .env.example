# Chave da Groq API (free tier) — obtenha em https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_aqui

# Chave pública da API do DataJud (CNJ) — usada para validar processos citados.
# A chave pública vigente fica em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Se não for definida, o sistema usa a chave pública publicada como fallback.
DATAJUD_API_KEY=

# Desativa a telemetria do ChromaDB (evita warnings de posthog)
ANONYMIZED_TELEMETRY=False
